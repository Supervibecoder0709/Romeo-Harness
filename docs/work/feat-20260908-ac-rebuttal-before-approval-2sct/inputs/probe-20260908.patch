+    def _step_body(self, title):
+        """절차 목록에서 그 단계 하나의 본문만. 다음 번호 항목이나 절 끝에서 끊는다."""
+        lines = self.skill.split("\n")
+        out, on = [], False
+        for ln in lines:
+            m = re.match(r"^(\d+)\. \*\*(.+?)\.\*\*", ln)
+            if m:
+                if on:
+                    break
+                on = m.group(2) == title
+            elif ln.startswith("## ") and on:
+                break
+            if on:
+                out.append(ln)
