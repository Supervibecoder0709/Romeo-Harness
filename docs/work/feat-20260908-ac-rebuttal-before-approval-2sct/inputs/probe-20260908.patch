diff --git a/adapters/orca/prompts/ac-rebuttal-brief.md b/adapters/orca/prompts/ac-rebuttal-brief.md
new file mode 100644
index 0000000..e17cefb
--- /dev/null
+++ b/adapters/orca/prompts/ac-rebuttal-brief.md
@@ -0,0 +1,23 @@
+너는 작업 단위 `<id>` 의 **반대 독자**다.
+
+아래 구분선 뒤에 이어지는 **확인란만** 읽는다 — 저장소를 읽거나 검색해도 되지만
+**아무것도 쓰지 않고 검사·빌드를 실행하지 않는다**. **판정을 내지 않는다** — 너의 출력은
+승인 여부가 아니라 사람이 문장을 고칠 때 쓰는 입력이다.
+
+수용 기준(AC) 하나마다 다음 형식으로 답한다. 빠뜨리지 않는다.
+
+### AC-n
+- 반례: 이 AC 를 **글자 그대로 충족하면서도 의도를 배신하는** 그럴듯한 산출물 하나.
+  빈 값·명백한 미구현이 아니라, 형태가 그럴듯하고 내용이 거짓인 것이어야 한다. 없으면 「없음」과 그 이유.
+- 검토 시점: 구현이 끝난 **검토 시점에 참일 수 있는 명제**인가. 사후 관측이 불가능한 것
+  (누가 언제 무엇을 먼저 했는지 같은 시간 순서)·다른 경우를 말하는 부수 문장·검토자가
+  확인할 수단이 없는 요구가 있으면 지적한다.
+- 표현: 전칭 표현·열거되지 않은 집합·한 문장에 두 경우가 섞인 것이 있으면 지적한다.
+  전칭 문장은 **여집합으로 다시 쓸 수 있는지**도 본다.
+
+마지막에 `## 요약` 으로 고쳐야 할 AC 를 번호와 한 줄 이유로 나열한다.
+**문장을 대신 써 주지 않는다** — 무엇이 문제인지만 말한다.
+
+---
+
+아래가 그 확인란이다.
diff --git a/core/policy/packages.yaml b/core/policy/packages.yaml
index 7cb8c6c..1473870 100644
--- a/core/policy/packages.yaml
+++ b/core/policy/packages.yaml
@@ -296,8 +296,28 @@ budgets:
   brief_max_lines: 120
   charter_max_lines: 250
 
+# ── 확인란 수용 기준 검사 ─────────────────────────────────────────────────────
+# 요구하는 자리(확인란)와 그것을 반박하는 자리를 승인 앞으로 옮긴다. 둘 다 경고까지만이다(K-31).
+ac_lint:
+  # 전칭 표현 — 반례가 무한해 구현이 「종류를 세는」 반복에 들어간다.
+  universal_patterns:
+    - "어떤 .{1,12}이든"
+    - "어느 .{1,12}든"
+    - "전부"
+    - "모든"
+    - "하나라도"
+    - "하나(가|만) .{1,20}도"
+    - "항상"
+    - "언제나"
+    - "어떤 경우에도"
+  # 반박 기록의 자리와 형식. approve 가 찾는 접두이자 절차가 지시하는 접두다(§11).
+  rebuttal_prefix: "inputs/ac-rebuttal-"
+  rebuttal_heading: "### AC-"
+
 # ── 경고 메시지 카탈로그 ──────────────────────────────────────────────────────
 warnings:
+  AC_UNIVERSAL: 확인란의 수용 기준에 전칭 표현이 있다 — 반례가 무한하다. 닫힌 집합을 열거하거나 파일 단위 격리처럼 달성 가능한 형태로 고친다.
+  AC_UNREBUTTED: 승인 전 반박 기록이 없거나 이 AC 를 덮지 못한다 — 반박 읽기 단계를 밟는다.
   WORKTREE_ISOLATES_CODE_ONLY: worktree는 코드 변경만 분리한다. DB·배포 환경·브라우저 세션·외부 서비스 변경은 분리되지 않으므로 환경 계획을 적는다.
   CAPABILITY_CHECK_REQUIRED: 필요한 도구·능력을 실행 전에 프로브한다. 없으면 가능한 척 우회하지 않고 BLOCKED_CAPABILITY로 보고한다.
   DOCS_ONLY_CHANGE: 문서·규칙만 바뀐다. required_checks는 스키마·링크·길이 검사다.
