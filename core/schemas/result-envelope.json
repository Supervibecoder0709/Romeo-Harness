{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "romeo/result-envelope",
  "title": "Romeo 결과 계약(ResultEnvelope)",
  "description": "실행 런타임의 출력을 정규화한 결과 계약. 동등성 판정이 비교하는 대상이고 증거를 복제하지 않는다(C-C3·D-12·K-63). 구현자가 gate_verdict PASS 를 낼 때는 checks 가 1건 이상이고 evidence_ref 가 채워져 있어야 한다 — 실행하지 않은 것을 완료로 선언할 수 없다(K-51). 검토자는 검사를 실행하지 않으므로 그쪽 증거 규칙은 역할 계약이 소유하고 동등성 판정이 강제한다(K-63). notes 는 실행자가 판정의 맥락(예: 이 FAIL 이 자기 변경과 무관하다는 근거)을 계약 안에 남기는 자유 서술 자리이고 판정에 쓰이지 않는다 — 종료 검사·동등성 판정·역할 계약 검사는 이 필드를 읽지 않으며, 판정은 gate_verdict·checks·findings 로만 낸다. fail_reasons 는 게이트를 내린 사유의 **닫힌 목록**이다 — 검토 절차가 열거한 여덟 개 코드만 값으로 받으므로 목록 밖 사유를 담은 봉투는 여기서 거부된다. 이 자리는 **선택**이다: 이 필드가 생기기 전에 기록된 판정에도 같은 스키마가 걸리기 때문에, FAIL 봉투가 사유를 실제로 담았는지는 종료 검사가 지금 닫으려는 산출물의 봉투에 대해서만 요구한다. 목록 밖의 우려는 findings 로 적고 판정은 PASS 로 내며, 목록을 늘릴지는 사람이 정한다(K-61).",
  "type": "object",
  "required": [
    "schema",
    "unit_id",
    "role",
    "task_envelope_ref",
    "checks",
    "gate_verdict",
    "blocked_reason",
    "findings",
    "evidence_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "romeo/result-envelope@0.1.0"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^(chg|feat|init)-[0-9]{8}-[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]{4}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "implementer",
        "reviewer"
      ]
    },
    "task_envelope_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "exit_code"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "gate_verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "BLOCKED_CAPABILITY",
        "BLOCKED_APPROVAL",
        "BLOCKED_DOCS"
      ]
    },
    "fail_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "AC_UNMET",
          "UNAPPROVED_ACTION",
          "OUT_OF_SCOPE_WRITE",
          "CHECK_PLAN_CHANGED",
          "EVIDENCE_NOT_RECORDED",
          "CHECK_NOT_RERUNNABLE",
          "ROLE_CONTRACT_VIOLATION",
          "FAILED_CHECK_CLAIMED_PASS"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer"
          }
        }
      }
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "schema": {},
        "unit_id": {},
        "role": {
          "const": "implementer"
        },
        "task_envelope_ref": {},
        "checks": {
          "minItems": 1
        },
        "gate_verdict": {
          "const": "PASS"
        },
        "blocked_reason": {},
        "fail_reasons": {},
        "findings": {},
        "notes": {},
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "additionalProperties": false,
      "properties": {
        "schema": {},
        "unit_id": {},
        "role": {
          "const": "reviewer"
        },
        "task_envelope_ref": {},
        "checks": {},
        "gate_verdict": {},
        "blocked_reason": {},
        "fail_reasons": {},
        "findings": {},
        "notes": {},
        "evidence_ref": {}
      }
    },
    {
      "additionalProperties": false,
      "properties": {
        "schema": {},
        "unit_id": {},
        "role": {},
        "task_envelope_ref": {},
        "checks": {},
        "gate_verdict": {
          "enum": [
            "FAIL",
            "BLOCKED"
          ]
        },
        "blocked_reason": {},
        "fail_reasons": {},
        "findings": {},
        "notes": {},
        "evidence_ref": {}
      }
    }
  ]
}
