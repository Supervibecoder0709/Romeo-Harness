{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "romeo/frontmatter",
  "title": "Romeo 작업 문서 frontmatter",
  "description": "docs/work/<unit-id>/{spec,brief,charter}.md 의 frontmatter. 분류 기록 겸 재개 체크포인트(D-05, C-B4).",
  "type": "object",
  "required": [
    "id",
    "type",
    "unit",
    "mode",
    "intent",
    "facets",
    "gates",
    "profile",
    "status",
    "routing",
    "created",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(chg|feat|init)-[0-9]{8}-[a-z0-9]+(-[a-z0-9]+)*-[a-z0-9]{4}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "spec",
        "brief",
        "charter"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "delivery",
        "discovery",
        "experiment"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "delete",
        "deploy",
        "mixed"
      ]
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "payment",
          "privacy-security",
          "legal",
          "ops-data-deletion",
          "migration",
          "public-api",
          "irreversible-policy",
          "availability"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "escalate",
          "expose",
          "iam",
          "merge",
          "ownership",
          "pr",
          "publish",
          "push",
          "send",
          "share",
          "token-scope",
          "transfer",
          "upload",
          "worktree-remove"
        ]
      },
      "description": "되돌리기 어려운 행위. execution-guards.yaml 의 trigger 와 대조해 실행 가드를 발동시킨다(K-66). 선언하지 않으면 가드가 걸리지 않는다 — 종료 검사가 승인을 요구하지 않는다."
    },
    "profile": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "blast_radius": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "uncertainty": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "done",
        "dropped",
        "superseded"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "policy_version",
        "fired_rules"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "fired_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "approved_at",
          "approved_by",
          "superseded_at",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "approved_at": {
            "type": "string"
          },
          "approved_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "superseded_at": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
